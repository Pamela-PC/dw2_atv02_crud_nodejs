<%- include('partials/header.ejs')%>    
<%- include('partials/navbar.ejs')%> 

   <h4 style="text-align: center;">Melhores Episódios</h4>
    
   <div class="container">
            <div class="card">
                <div class="card-header">
                <h1>Cadastrar Melhores Episódios</h1>
                </div>

                <div class="card-body">
                    <form action="/mlrsEpisodios/cadastrar" method="POST">
                        <label for="episodio">Nome do Episódio: </label>
                        <input type="text" id="episodio" name="episodio" placeholder="Insira o nome do episódio" class="form-control" required>

                        <label for="resumo">Resumo do Episódio: </label>
                        <input type="text" id="resumo" name="resumo" placeholder="Insira o resumo do episódio" class="form-control" required>
                        <br>

                        <button type="submit" class="btn btn-success">Cadastrar</button>
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
    
    <div class="container">
        <div class="card">
            <div class="card-body">
                <table border="1">
                    <tr>
                        <th>Episódio: </th>
                        <th>Resumo: </th>
                        <th style="text-align: center;" colspan="2">Ações:</th>
                    </tr>
                    <% mlrsEpisodios.forEach(function(mlrEpisodio){%>
                    <tr>
                        <td><%=mlrEpisodio.episodio%></td>
                        <td><%=mlrEpisodio.resumo%></td>
                        <td>
                            <a class="btn btn-warning" href="/mlrsEpisodios/editar/<%=mlrEpisodio.id %>">Editar</a>
                        </td>                             
                        <td>
                            <a class="btn btn-danger" href="/mlrsEpisodios/excluir/<%=mlrEpisodio.id%>" 
                            onclick="return confirm('Deseja mesmo excluir o cliente <%= mlrsEpisodios.episodio %>')">Excluir</a>
                        </td>
                    </tr>

                <%}) %>
                </table>
                    <br><br>
            </div>
        </div>
    </div>
<%- include('partials/footer.ejs')%>    