<%- include('partials/header.ejs')%>    
<%- include('partials/navbar.ejs')%>    

 <h4 style="text-align: center;">Curiosidades</h4>
    <div class="container">
            <div class="card">
                <div class="card-header">
                <h1>Cadastrar Curiosidade</h1>
                </div>

                <div class="card-body">
                    <form action="/curiosidades/cadastrar" method="POST">
                        <label for="ordem">Ordem: </label>
                        <input type="text" id="ordem" name="ordem" placeholder="Insira o número de ordenação" class="form-control" required>

                        <label for="curiosidade">Insira a curiosidade: </label>
                        <input type="text" id="curiosidade" name="curiosidade" placeholder="Insira uma curiosidade sobre Diários de uma Apotecária" class="form-control" required>
                        <br>

                        <button type="submit" class="btn btn-success">Cadastrar</button>
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
    <div class="container">
        <div class="card">
            <div class="card-body">
                <table border="1">
                    <tr>
                        <th>Ordem: </th>
                        <th>Curiosidade: </th>
                         <th style="text-align: center;" colspan="2">Ações:</th>
                    </tr>
                    <% curiosidades.forEach(function(curiosidade){%>
                    <tr>
                        <td><%=curiosidade.ordem%></td>
                        <td><%=curiosidade.curiosidade%></td>
                        <td>
                            <a class="btn btn-warning" href="/curiosidades/editar/<%=curiosidade.id %>">Editar</a>
                        </td>                             
                        <td>
                            <a class="btn btn-danger" href="/curiosidades/excluir/<%=curiosidade.id%>" 
                            onclick="return confirm('Deseja mesmo excluir essa curiosidade <%= curiosidade.ordem %>')">Excluir</a>
                        </td>
                    </tr>

                    <%}) %>
                    </table>
                <br><br><br><br>
            </div>
        </div>
    </div>

<%- include('partials/footer.ejs')%>    